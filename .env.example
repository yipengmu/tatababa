# Local server
PORT=3000
PUBLIC_SITE_URL=https://example.com

# Admin authentication (required on Vercel)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt$replace-with-generated-salt$replace-with-generated-hash
AUTH_SECRET=replace-with-at-least-32-random-bytes

# Production content persistence (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
