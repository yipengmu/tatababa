{
  "name": "tatababa-homepage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/index.ts",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "build": "npm run typecheck && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_ENV=test node --import tsx --test tests/**/*.test.ts",
    "db:init": "tsx scripts/init-db.ts",
    "auth:hash": "tsx scripts/hash-password.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.3",
    "@types/node": "^22.17.2",
    "cross-env": "^10.0.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  }
}
